{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "vueCompilerOptions": {
    "strictTemplates": true
  },
  "include": [
    "src_assets/common/assets/web/**/*.ts",
    "src_assets/common/assets/web/**/*.vue"
  ]
}
