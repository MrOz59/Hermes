+				return nullptr;
+			}
+
+			wlr_dmabuf_attributes attrs =
+			{
+				.width = int32_t( uWidth ),
+				.height = int32_t( uHeight ),
+				.format = uDrmFormat,
+				.modifier = bForceLinearModifier ? DRM_FORMAT_MOD_LINEAR : gbm_bo_get_modifier( pBo ),
+			};
