# Prerequisites
*.d
# ...but not packaged drop-in directories, which end in .d by convention
# (wireplumber.conf.d, modprobe.d, ...) and are content, not build output.
!**/*.d/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# JetBrains IDE
.idea/

# VSCode IDE
.vscode/

# build directories
build/
build-test/
cmake-*/

# Frontend dependencies
node_modules/
package-lock.json
!/docs/site/package-lock.json

# Translations
*.mo
*.pot

# Dummy macOS files
.DS_Store

# Python
venv/

# Build directories
cmake-build-*/
pkg/
pkg-output/
*.pkg.tar.zst
apollo-linux-build

docs/codex/*
jsson-lsp.log
test_sunshine.log*
write_file_test_*.txt

# mcpp build output and local toolchain
/target/
/mcpp/*/target/
/tests/display_restore/target/
/.mcpp/
/.toolchain/

# Docusaurus and generated C++ reference
/docs/site/.docusaurus/
/docs/site/.generated/
