<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>@PROJECT_FQDN@</id>

  <name>@PROJECT_NAME@</name>
  <summary>@PROJECT_BRIEF_DESCRIPTION@</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>@PROJECT_LICENSE@</project_license>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
    <control>gamepad</control>
  </supports>

  <url type="homepage">@PROJECT_HOMEPAGE_URL@</url>
  <url type="bugtracker">https://github.com/MrOz59/Hermes/issues</url>
  <url type="faq">https://github.com/MrOz59/Hermes/blob/main/docs/troubleshooting.md</url>
  <url type="help">https://github.com/MrOz59/Hermes/blob/main/docs/getting_started.md</url>
  <url type="contact">https://github.com/MrOz59/Hermes/discussions</url>

  <description>
    <p>
      @PROJECT_LONG_DESCRIPTION@
    </p>

    <p>Hermes serves its web interface over HTTPS with a self-signed certificate.
      The browser may show a certificate warning on first connection.</p>
  </description>

  <releases>
    <release version="@PROJECT_VERSION@" date="@PROJECT_YEAR@-@PROJECT_MONTH@-@PROJECT_DAY@">
      <description>
        <p>
          See the full changelog on GitHub

          <!-- changelog -->
        </p>
      </description>
    </release>
  </releases>

  <developer id="io.github.mroz59">
    <name>Hermes contributors</name>
  </developer>
  <content_rating type="oars-1.0">
    <content_attribute id="language-profanity">moderate</content_attribute>
    <content_attribute id="language-humor">mild</content_attribute>
    <content_attribute id="money-purchasing">mild</content_attribute>
  </content_rating>
  <launchable type="desktop-id">@PROJECT_FQDN@.desktop</launchable>
</component>
